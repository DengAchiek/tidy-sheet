# Runtime values: configure these as secrets in Sites before activating checkout.
# For local development, put values in an ignored .dev.vars file.
PAYSTACK_SECRET_KEY=
PAYSTACK_REGULAR_PLAN_CODE=
PAYSTACK_MONTHLY_PLAN_CODE=
PAYSTACK_ANNUAL_PLAN_CODE=
APP_URL=https://tidysheet-cleaner.sudpix4.chatgpt.site
# Optional trial, in days. Zero means payment is required after the free sample.
TRIAL_DAYS=7
SUPPORT_EMAIL=

# Optional build-time setting for a separate Cloudflare Workers deployment.
# Set this under Worker Settings > Builds > Variables and secrets before building.
# Leave unset for Sites publication and local previews.
TIDYSHEET_D1_DATABASE_ID=

# Private, one-use administrator invitation. Email alone never grants a role.
# Hash a cryptographically random 40-hex-character setup code with SHA-256.
# Configure both as runtime secrets; give the raw code privately to the owner.
ADMIN_INVITE_EMAIL=
ADMIN_INVITE_HASH=
